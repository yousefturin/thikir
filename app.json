{
  "expo": {
    "name": "Thikir",
    "description": "App description",
    "slug": "thikir",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#FFFFFF",
    "androidNavigationBar": {
      "backgroundColor": "#F2F4F7",
      "barStyle": "light-content"
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "light-content"
    },
    "ios": {
      "bundleIdentifier": "com.yusefturin.thikir",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "0000",
      "userInterfaceStyle": "light",
      "splash": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "android": {
      "package": "com.yusefturin.thikir",
      "edgeToEdgeEnabled": true,
      "userInterfaceStyle": "light",
      "splash": {
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF",
        "image": "./assets/AndroidSplash.png"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/AndroidAdaptiveIcon.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      ["expo-font"],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location. This enables features such as prayer time calculations based on your location.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location. This enables features such as prayer time calculations based on your location.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location. This enables features such as prayer time calculations based on your location."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/azan.caf"]
        }
      ]
    ]
  }
}
